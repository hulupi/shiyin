{
  "name": "shiyin-desktop",
  "version": "0.1.18",
  "private": true,
  "description": "拾音桌面本地播放器",
  "productName": "拾音",
  "author": "Shiyin",
  "main": "main.cjs",
  "scripts": {
    "prestart": "npm run build:runtime",
    "start": "electron .",
    "package:win": "npm run build:runtime && electron-builder --win nsis --x64 --config.electronDist=node_modules/electron/dist --publish never",
    "package:mac": "npm run build:runtime && electron-builder --mac dmg --publish never",
    "build:runtime": "node build-runtime.mjs"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.shiyin.desktop",
    "icon": "../fpk/ICON_256.PNG",
    "directories": {
      "output": "dist/local"
    },
    "files": [
      "main.cjs",
      "package.json",
      "title-bar.cjs",
      "title-bar.css"
    ],
    "artifactName": "Shiyin-Local-Setup-${version}-${arch}.${ext}",
    "mac": {
      "icon": "build/icon-mac.png"
    },
    "nsis": {
      "include": "installer.nsh"
    },
    "win": {
      "signExecutable": false
    },
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "backend/**/*",
          "frontend/**/*",
          "launch.cjs",
          "tray.png",
          "trayTemplate*.png",
          "package.json"
        ]
      },
      {
        "from": "build/runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*",
          "!.bin{,/**/*}",
          "!.package-lock.json"
        ]
      }
    ]
  }
}
